[{"name": "insert", "old": "<!-- DOMINO PREMIUM TILES + WORDS-STYLE BOARD END -->", "neu": "<!-- DOMINO PREMIUM TILES + WORDS-STYLE BOARD END -->\n<!-- OHANA THREE GAMES: CHICKEN FOOT + SPADES 2 ROBOTS START (2026-11-18) -->\n<script id=\"ohana-three-games-v1\">\n(function(){\n'use strict';\nif(window.ohanaThreeGames)return;\nconst out={chicken:false,spades2:false};\n// Chicken Foot: label legs and toes, start each line at its own number, hide toes nobody can use yet\ntry{if(typeof dominoTrainLayout==='function'&&typeof dominoBoardLayout==='function'&&typeof dominoTileFace==='function'){\n const orig=dominoTrainLayout;\n dominoTrainLayout=function(st,g,rowLimit=1100){\n  if(!st||!st.chicken||!st.trains)return orig.apply(this,arguments);\n  const engine=st.board[0]?.tile,targets=new Set((st.playable||[]).map(x=>String(x).split(':')[1]));\n  const needFoot=(st.pendingFoot||[]).filter(id=>st.trains[id]&&!st.trains[id].tiles.length);\n  let html=engine?dominoTileFace(engine,'tabindex=\"-1\" style=\"--dx:20px;--dy:16px;--dw:72px;--dh:144px\"','board-piece vertical'):'';\n  html+='<span class=\"domino-train-label dmx-cf-title\" style=\"position:absolute;left:108px;top:58px;color:#fff6df;font:600 22px Fredoka\">Chicken Foot \u00b7 '+(needFoot.length?'finish the chicken foot':'12|12 engine')+'</span>';\n  const layout={w:Math.max(240,rowLimit),h:180,html:'',pieces:[]};let y=200;\n  for(const [id,line] of Object.entries(st.trains)){\n   const show=line.tiles.length||line.leg||needFoot.includes(id)||targets.has('train-'+id);\n   if(!show){layout['train-'+id]={x:-4000,y:-4000};continue;}\n   const packed=dominoBoardLayout(line.tiles,{left:line.start??engine?.a},st.lastPlay?.tile?.id,rowLimit);\n   const tag=line.open===false?' \u00b7 Closed by double':needFoot.includes(id)?' \u00b7 Chicken foot':'';\n   html+=`<span class=\"domino-train-label\" style=\"position:absolute;left:20px;top:${y-28}px;color:#fff6df;font:600 18px Fredoka\">${esc(line.label||id)} \u00b7 ${Number(line.end)}${tag}</span><div class=\"domino-train-path\" style=\"position:absolute;left:0;top:${y}px;width:${packed.w}px;height:${packed.h}px\">${packed.html}</div>`;\n   const end=packed.pieces.length?packed.right:{x:100,y:80};layout['train-'+id]={x:end.x,y:y+end.y};\n   layout.pieces.push(...packed.pieces.map(p=>({...p,y:p.y+y})));layout.w=Math.max(layout.w,packed.w);y+=packed.h+48;\n  }\n  layout.h=y;layout.html=html;return layout;\n };\n out.chicken=true;}}catch(e){}\n// Spades: you + one person + two Ohana Robots\ntry{if(typeof ohanaStartPlan==='function'&&typeof ohanaStartSubmit==='function'){\n const plan0=ohanaStartPlan,sub0=ohanaStartSubmit;\n ohanaStartPlan=function(state,sy){\n  if(state&&state.opponent==='bot2'){\n   if(state.game!=='spades')throw new Error('Two robots is for Spades.');\n   const members=ohanaStartPeople(sy),ids=[...new Set(state.people||[])];\n   if(ids.length!==1)throw new Error('Choose 1 person to be your partner.');\n   if(!members.some(p=>p.id===ids[0]))throw new Error('Please choose someone from this room.');\n   return {type:'spades',opponent:'bot2',difficulty:'easy',max_players:2,mode:'robots2'};\n  }\n  return plan0.apply(this,arguments);\n };\n ohanaStartSubmit=async function(state,sy,request){\n  if(!(state&&state.opponent==='bot2'))return sub0.apply(this,arguments);\n  request=request||api;\n  if(state.uncertain)throw new Error('We could not confirm the game. Check Your games before starting another.');\n  const plan=ohanaStartPlan(state,sy);\n  if(!state.table){let result;try{result=await request('/api/game/create',plan,'POST',state.room);}catch(error){state.uncertain=true;throw error;}if(!Number.isInteger(result?.id)||result.id<1){state.uncertain=true;throw new Error('We could not confirm the game. Check Your games before starting another.');}state.table=result.id;}\n  state.sent||=[];\n  for(const id of state.people)if(!state.sent.includes(id)){await request('/api/game/'+state.table+'/invite',{member_id:id},'POST',state.room);state.sent.push(id);}\n  return state.table;\n };\n out.spades2=true;}}catch(e){}\nout.ok=out.chicken&&out.spades2;\nwindow.ohanaThreeGames=out;\n})();\n</script>\n<!-- OHANA THREE GAMES END -->\n"}, {"name": "opp", "old": "(rules.robot?'<button type=\"button\" data-start-opponent=\"bot\" aria-pressed=\"'+(state.opponent==='bot')+'\">Ohana Robot</button>':'')", "neu": "(rules.robot?'<button type=\"button\" data-start-opponent=\"bot\" aria-pressed=\"'+(state.opponent==='bot')+'\">Ohana Robot</button>':'')+(state.game==='spades'?'<button type=\"button\" data-start-opponent=\"bot2\" aria-pressed=\"'+(state.opponent==='bot2')+'\">One person + 2 robots</button>':'')"}, {"name": "people_a", "old": "if(family)content+='<p>'+instruction", "neu": "if(family||state.opponent==='bot2')content+='<p>'+(state.opponent==='bot2'?'Choose 1 person to be your partner. Two Ohana Robots sit across from you as the other team.':instruction)"}, {"name": "people_b", "old": "rules.max===2?'radio':'checkbox'", "neu": "rules.max===2||state.opponent==='bot2'?'radio':'checkbox'"}, {"name": "chosen", "old": "const chosen=state.opponent==='bot'?", "neu": "const chosen=state.opponent==='bot2'?state.people.map(id=>people.find(p=>p.id===id)?.name||'Family member').join(', ')+' + two Ohana Robots':state.opponent==='bot'?"}, {"name": "reviewtext", "old": "'+(family?'We will send '", "neu": "'+(family||state.opponent==='bot2'?'We will send '"}, {"name": "reviewbtn", "old": "<button type=\"button\" data-start-confirm>'+(family?'Send invitation'", "neu": "<button type=\"button\" data-start-confirm>'+(family||state.opponent==='bot2'?'Send invitation'"}, {"name": "help_cf", "old": "<p><strong>Chicken Foot at this Ohana table:</strong> this option uses the same two-end Draw-chain behavior. It does <strong>not</strong> create three chicken-foot branches or require three legs after a double. Follow the highlighted left/right ends.</p>", "neu": "<p><strong>Chicken Foot (real rules):</strong> the 12|12 engine starts the table. The first six tiles go around it as six legs, one tile each, before any line can grow. When anyone plays a double, it makes a chicken foot: the next three tiles must go on that double as its three toes before anyone plays anywhere else. If you cannot play, draw one tile; if it still does not fit, pass. Go out first to win. Everyone else counts the dots left in hand, and the 0|0 counts 50.</p>"}, {"name": "help_fives", "old": "<p>This is a double-twelve, seven-tile <strong>Draw-chain</strong> variant.", "neu": "<p>This is a double-twelve <strong>Draw-chain</strong> variant with a bigger deal: 12 tiles each for 2 to 4 players.</p><p>"}]